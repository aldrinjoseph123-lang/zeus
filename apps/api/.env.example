# ── Zeus CRM — API configuration ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

DATABASE_URL="postgresql://zeus:zeus@localhost:5432/zeus?schema=public"

# 32+ random chars. Signs session cookies AND encrypts stored O365 secrets.
# Generate: openssl rand -hex 32
APP_SECRET="change-me-openssl-rand-hex-32"

PORT=4000
NODE_ENV=development

# Public URL of the app — used for links inside Teams cards and emails,
# and as the OAuth redirect base for Microsoft sign-in.
APP_URL="http://localhost:5174"

# Comma-separated allowed browser origins in dev. In production the API serves
# the built frontend from the same origin and this is ignored.
CORS_ORIGINS="http://localhost:5174"

# Bootstrap admin, created on first `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@protect24x7.ae"
SEED_ADMIN_PASSWORD="ChangeMe#2026"

# Where uploads and local backup files land.
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"

# Path to pg_dump for the OneDrive backup job. Leave as-is inside Docker.
PG_DUMP_PATH="pg_dump"

# Office 365 is configured from Settings → Integrations in the UI, not here.
# These are only used to pre-fill that screen on a fresh install.
M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""
