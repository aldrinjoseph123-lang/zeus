# ── Zeus CRM — deployment configuration ───────────────────────────────────────
# Copy to .env next to docker-compose.yml, fill in, then: docker compose up -d

# Public URL of Zeus. Must match the redirect URI you register in Entra ID.
APP_URL=https://zeus.protect24x7.ae

# What Caddy answers on. A hostname gets a free certificate automatically.
# Use ":80" for a LAN-only install with no domain.
ZEUS_DOMAIN=zeus.protect24x7.ae

# Signs session cookies and encrypts the stored Microsoft 365 secret.
# Generate: openssl rand -hex 32
APP_SECRET=

# Database. Only the app container talks to Postgres.
POSTGRES_USER=zeus
POSTGRES_PASSWORD=
POSTGRES_DB=zeus

# Break-glass administrator created on first boot. Change the password after signing in.
SEED_ADMIN_EMAIL=admin@protect24x7.ae
SEED_ADMIN_PASSWORD=

# Optional: pre-fill Settings → Integrations. You can leave these blank and
# paste the values into the UI instead.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
